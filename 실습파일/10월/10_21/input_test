# 실습 - 숫자 입력 받아 계산하기

birth_year = int(input("태어난 연도를 입력하세요: "))
age = 2026 - birth_year
print("나이: ", age, "세")


# 실습 - 여러 개의 값 입력받기

country = input("거주 국가를 입력하세요: ")
city = input("거주 도시를 입력하세요: ")
print(country + "의 " + city + "에서 거주하시는군요!")


# 실습 - 두 수 입력받아 사칙연산

num1 = float(input("첫 번째 숫자를 입력하세요: "))
num2 = float(input("두 번째 숫자를 입력하세요: "))

print("덧셈:", num1 + num2)
print("뺄셈:", num1 - num2)
print("곱셈:", num1 * num2)
print("나눗셈:", num1 / num2)


# 실습 - 입력값 비교해 출력하기

temperature = float(input("현재 온도를 입력하세요: "))
is_hot = temperature >= 30
print("30도 이상인가요?", is_hot)


# 실습 - 입력·변환·계산·비교·출력(종합)

score1 = float(input("첫 번째 점수를 입력하세요: "))
score2 = float(input("두 번째 점수를 입력하세요: "))
score3 = float(input("세 번째 점수를 입력하세요: "))

average = (score1 + score2 + score3) / 3

is_pass = average >= 80

print("평균 점수:", average)
print("평균 80점 이상인가요?", is_pass)