# 실습5 - 세 값으로 설비 종합 상태 판정하기
temperature = float(input("온도 입력: "))
vibration = float(input("진동 입력: "))
current = float(input("전류 입력: "))

if temperature > 80 or vibration > 4.0:
    print("위험: 즉시정지")
elif current > 60 and temperature > 70:
    print("주의: 부하점검")
elif vibration > 2.5:
    print("주의: 진동관찰")
else:
    print("정상")