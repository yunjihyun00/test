# 실습2 - 여러 갈래로 점수 등급 판정하기
score = int(input("점수를 입력하세요: "))
if score >= 90:
    print("A")
elif score >= 80:
    print("B")
elif score >= 70:
    print("C")
else:
    print("F")


# 실습3 - 설비 온도 상태 판정하기
