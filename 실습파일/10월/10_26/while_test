# 실습2 - 플래그로 조건 만족 값 검색하기
found = False
n = int(input("측정 횟수 입력: "))

for i in range(n):
    value = int(input("측정값 입력: "))

    if value > 80:
        found = True
        break

if found:
    print("발견")
else:
    print("없음")