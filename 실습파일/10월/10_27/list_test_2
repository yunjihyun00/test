# 실습1 - for와 if를 결합해 조건에 맞는 값만 골라 출력하기
temperature = [25, 28, 32, 35, 30]

for temp in temperature:
    if temp >= 30:
        print("고온:", temp)


# 실습2 - 두 조건을 모두 만족하는 값 고르기
hours = [3, 8, 6, 12, 10, 9]

for hour in hours:
    if hour >= 5 and hour <= 10:
        print(hour)


# 실습3 - 조건에 맞는 값만 골라 평균 구하기
temperature = [25, 32, 36, 28, 31]

total = 0
count = 0

for temp in temperature:
    if temp > 30:
        total += temp
        count += 1

average = total / count

print("고온평균:", average)


# 실습4 - 조건에 맞는 값으로 새 리스트 만들기
temperature = [28, 32, 35, 31, 33, 25]

high_temp = []

for temp in temperature:
    if temp > 30:
        high_temp.append(temp)

print(high_temp)
print("개수:", len(high_temp))


# 실습5 - 값을 가공해 새 리스트 만들기
celsius = [25, 26, 24, 28, 27]

fahrenheit = []

for temp in celsius:
    f = temp * 1.8 + 32
    fahrenheit.append(f)

print(fahrenheit)


# 실습6 - 센서 데이터 종합 분석하기
temperature = [25, 32, 36, 28, 31, 35, 23]

total = 0
high_temp = []

for temp in temperature:
    total += temp

average = total / len(temperature)

for temp in temperature:
    if temp > 30:
        high_temp.append(temp)

high_average = sum(high_temp) / len(high_temp)

print("전체평균:", average)
print("고온개수:", len(high_temp))
print("고온평균:", high_average)