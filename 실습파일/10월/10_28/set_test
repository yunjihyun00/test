# 실습5 - 두 라인의 센서 구성 비교하기
line_A = {'S01', 'S02', 'S03', 'S05'}
line_B = {'S03', 'S04', 'S05'}

all_sensors = line_A.union(line_B)
common_sensors = line_A.intersection(line_B)

A_only = line_A.difference(line_B)
B_only = line_B.difference(line_A)

print("전체:", all_sensors)
print("공통:", common_sensors)
print("A만:", A_only)
print("B만:", B_only)


# 실습6 - 두 시점의 이벤트 센서 추적하기
yesterday = {'S01', 'S02', 'S03'}
today = {'S02', 'S03', 'S05'}

new_abnormal = today.difference(yesterday)
persistent_abnormal = yesterday.intersection(today)

print("신규 이상:", new_abnormal)
print("지속 이상:", persistent_abnormal)